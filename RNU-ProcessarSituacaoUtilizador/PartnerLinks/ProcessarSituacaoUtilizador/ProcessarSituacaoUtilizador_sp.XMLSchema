<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<schema targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/sp/ProcessarSituacaoUtilizador" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:db="http://xmlns.oracle.com/pcbpel/adapter/db/sp/ProcessarSituacaoUtilizador" elementFormDefault="qualified">
   <element name="InputParameters">
      <complexType>
         <sequence>
            <element name="ICT_NNU" type="decimal" db:index="1" db:type="NUMBER" minOccurs="0" nillable="true"/>
            <element name="ICT_DATA_NASC" type="dateTime" db:index="2" db:type="DATE" minOccurs="0" nillable="true"/>
            <element name="ICT_DATA_PROC_SDM" type="dateTime" db:index="3" db:type="DATE" minOccurs="0" nillable="true"/>
            <element name="ICT_SITUACAO" db:index="4" db:type="VARCHAR2" minOccurs="0" nillable="true">
               <simpleType>
                  <restriction base="string">
                     <maxLength value="100"/>
                  </restriction>
               </simpleType>
            </element>
            <element name="ICT_ENTIDADE" db:index="5" db:type="VARCHAR2" minOccurs="0" nillable="true">
               <simpleType>
                  <restriction base="string">
                     <maxLength value="100"/>
                  </restriction>
               </simpleType>
            </element>
         </sequence>
      </complexType>
   </element>
   <element name="OutputParameters">
      <complexType>
         <sequence>
            <element name="PROCESSAR_SITUACAO_UTILIZADOR" type="db:IGIF.T_COD_MSG_ARR" db:index="0" db:type="Array" minOccurs="0" nillable="true"/>
         </sequence>
      </complexType>
   </element>
   <complexType name="IGIF.T_COD_MSG_ARR">
      <sequence>
         <element name="PROCESSAR_SITUACAO_UTILIZADOR_ITEM" type="db:IGIF.T_COD_MSG" db:type="Struct" minOccurs="0" maxOccurs="unbounded" nillable="true"/>
      </sequence>
   </complexType>
   <complexType name="IGIF.T_COD_MSG">
      <sequence>
         <element name="CODIGO" db:type="VARCHAR2" minOccurs="0" nillable="true">
            <simpleType>
               <restriction base="string">
                  <maxLength value="25"/>
               </restriction>
            </simpleType>
         </element>
         <element name="MENSAGEM" db:type="VARCHAR2" minOccurs="0" nillable="true">
            <simpleType>
               <restriction base="string">
                  <maxLength value="512"/>
               </restriction>
            </simpleType>
         </element>
      </sequence>
   </complexType>
</schema>]]></con:schema>
    <con:targetNamespace>http://xmlns.oracle.com/pcbpel/adapter/db/sp/ProcessarSituacaoUtilizador</con:targetNamespace>
</con:schemaEntry>
